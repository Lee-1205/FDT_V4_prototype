+function Invoke-Native {
+    <#
+        Runs an external command and returns its stdout, ignoring whatever it
+        writes to stderr. Without this, $ErrorActionPreference = 'Stop' turns a
+        single stderr line into a terminating error: `py -0p` prints its banner
+        there, and pip routinely prints warnings there. Check $LASTEXITCODE at
+        the call site to decide whether the command actually succeeded.
+    #>
+    param([string]$Executable, [string[]]$Arguments)
+
+    $ErrorActionPreference = 'Continue'
+    return & $Executable @Arguments
 }
 
-& $python -c "import sys; assert sys.version_info >= (3, 10), 'Python 3.10 or newer is required'"
+function Get-PythonCandidates {
+    <#
+        Every interpreter worth trying, newest first, as arrays of the
+        executable followed by any leading arguments.
+
+        `py -0p` is asked first because it lists every registered install,
+        including ones that are not on PATH. Plain `py -3` is not enough: the
+        launcher's default can be an older build, and this release needs 3.10+.
+        A bare `python` on PATH goes last, and the Microsoft Store stub under
+        ...\WindowsApps\ is skipped outright because it exits without running
+        anything, which would look like "no Python installed".
+    #>
+    $candidates = @()
+    if (Get-Command py -ErrorAction SilentlyContinue) {
+        $installs = @()
+        foreach ($line in (Invoke-Native 'py' @('-0p'))) {
+            if ($line -match '^\s*\*?\s*-(?:V:)?(\d+\.\d+)[^\s]*\s+\*?\s*(.+\.exe)\s*$') {
+                $installs += [pscustomobject]@{
+                    Version = [version]$matches[1]
+                    Path    = $matches[2].Trim()
+                }
+            }
+        }
+        foreach ($install in ($installs | Sort-Object Version -Descending)) {
+            $candidates += , @($install.Path)
+        }
+        $candidates += , @('py', '-3')
+    }
+    foreach ($command in Get-Command python -All -ErrorAction SilentlyContinue) {
+        if ($command.Source -notlike '*\WindowsApps\*') {
+            $candidates += , @($command.Source)
+        }
+    }
+    # The leading comma stops PowerShell from unrolling the outer array, which
+    # would flatten this list of commands into one flat list of strings.
+    return , $candidates
+}
+
+function Find-Python {
+    $probe = 'import sys; print(1 if sys.version_info >= (3, 10) else 0)'
+    foreach ($candidate in (Get-PythonCandidates)) {
+        $executable = $candidate[0]
+        $leading = if ($candidate.Length -gt 1) { $candidate[1..($candidate.Length - 1)] } else { @() }
+        $supported = Invoke-Native $executable ($leading + @('-c', $probe))
+        if ($LASTEXITCODE -eq 0 -and $supported -eq '1') {
+            return , $candidate
+        }
+    }
+    return $null
