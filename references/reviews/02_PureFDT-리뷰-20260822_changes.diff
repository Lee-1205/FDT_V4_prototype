+def resolve_dtype(device: torch.device, requested: str = "auto") -> torch.dtype:
+    """Pick the compute dtype.
+
+    `auto` uses bf16 only where the GPU implements it natively, meaning Ampere
+    (sm_80) or newer. Older cards emulate bf16: it measured slower than fp32 on
+    a GTX 1650, and its 8-bit mantissa spaces logits 0.125 apart near the +/-30
+    clip, which produces exact top-1/top-2 ties and makes greedy decoding pick
+    arbitrarily. fp32 is both faster and steadier there.
+
+    `fp32` is selectable on any device, because the cached-vs-recompute logit
+    tolerance quoted in MODEL_CARD.md is an fp32 result and only holds in fp32.
+    """
+    requested = requested.lower().strip()
+    if requested == "auto":
+        if device.type != "cuda":
+            return torch.float32
+        major, _ = torch.cuda.get_device_capability(device)
+        return torch.bfloat16 if major >= 8 else torch.float32
+    if requested == "bf16":
+        return torch.bfloat16
+    if requested == "fp32":
+        return torch.float32
+    raise ValueError("dtype must be auto, bf16, or fp32")
+
+
+def load_checkpoint(path: Path) -> dict[str, Any]:
+    """Load the checkpoint without granting the pickle arbitrary code execution.
+
+    This release stores only tensors, an OrderedDict, and plain Python metadata,
+    so torch's restricted unpickler is enough. Reading a redistributed file with
+    weights_only=False would let a tampered checkpoint run code at load time.
+    """
+    try:
+        return torch.load(path, map_location="cpu", weights_only=True, mmap=True)
+    except TypeError:
+        return torch.load(path, map_location="cpu", weights_only=True)
 
 
